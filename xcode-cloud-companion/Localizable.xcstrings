    "Apple is still processing the build. The groups open when the processing ends." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple traite encore le build. Les groupes s’ouvriront à la fin du traitement."
          }
        }
      }
    },
    "Apple is waiting for your answer about encryption before any distribution." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple attend votre réponse sur le chiffrement avant toute distribution."
          }
        }
