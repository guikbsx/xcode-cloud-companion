        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@ has %@." : {
      "comment" : "Small note about flaky tests. The placeholders are the app, the workflow and a count such as “2 flaky tests”. Keep the middle dot.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ compte %@."
          }
        }
      }
    },
