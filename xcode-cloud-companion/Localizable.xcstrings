    },
    "This isn’t an Xcode Cloud usage export: missing %@." : {
      "comment" : "Keep \"Xcode Cloud\", \"App Store Connect\" and \"TestFlight\" untranslated as product names.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas un export d’utilisation Xcode Cloud : il manque %@."
          }
        }
      }
    },
    "This key was saved by another build of the app, and macOS only lets that build delete it. In Keychain Access, delete “%@”, then try again." : {
      "comment" : "The placeholder is the keychain item name, to type in Keychain Access search field.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé a été enregistrée par une autre version de l’app, et macOS ne laisse que celle-ci la supprimer. Dans Trousseau d’accès, supprimez « %@ », puis réessayez."
          }
        }
      }
    },
