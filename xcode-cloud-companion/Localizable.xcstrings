    },
    "App Store Connect can’t be reached." : {
      "comment" : "Keep \"Xcode Cloud\", \"App Store Connect\" and \"TestFlight\" untranslated as product names.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect est injoignable."
          }
        }
      }
    },
    "App Store Connect is limiting requests. Try again in a few minutes." : {
      "comment" : "Keep \"Xcode Cloud\", \"App Store Connect\" and \"TestFlight\" untranslated as product names.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect limite les requêtes. Réessayez dans quelques minutes."
          }
        }
      }
    },
    "App Store Connect refused the key. Check the Issuer ID, the Key ID, and that the key is still active." : {
      "comment" : "Keep \"Xcode Cloud\", \"App Store Connect\" and \"TestFlight\" untranslated as product names.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect a refusé la clé. Vérifiez l’Issuer ID, l’ID de la clé, et que la clé est toujours active."
          }
        }
      }
    },
    "App Store Connect refused the request." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect a refusé la requête."
          }
        }
      }
    },
    "App Store Connect refuses this key." : {
      "comment" : "Keep \"Xcode Cloud\", \"App Store Connect\" and \"TestFlight\" untranslated as product names.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect refuse cette clé."
          }
        }
      }
    },
    "App Store Connect returned an error (%lld)" : {
      "comment" : "Keep \"Xcode Cloud\", \"App Store Connect\" and \"TestFlight\" untranslated as product names.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect a renvoyé une erreur (%lld)"
          }
        }
      }
    },
    "App Store Connect sent an unexpected response." : {
      "comment" : "Keep \"Xcode Cloud\", \"App Store Connect\" and \"TestFlight\" untranslated as product names.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect a envoyé une réponse inattendue."
          }
        }
      }
    },
    "Apple did not confirm the launch, and the build list shows no new build. Nothing seems to have started; you can try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple n’a pas confirmé le lancement et la liste des builds n’en montre aucun de nouveau. Rien ne semble avoir démarré ; vous pouvez réessayer."
          }
        }
      }
    },
    "Apple does not expose the plan or its reset date in the API. Without the right date, the gauge counts the hours over the wrong cycle." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple n’expose ni le forfait ni sa date de réinitialisation dans l’API. Sans la bonne date, la jauge compte les heures sur le mauvais cycle."
          }
        }
      }
    },
    "Apple gave an address this app doesn’t trust, so nothing was downloaded." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple a donné une adresse à laquelle cette app ne fait pas confiance : rien n’a été téléchargé."
          }
        }
      }
    },
    "Apple gave no download address for this file. It may have expired." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple n’a donné aucune adresse de téléchargement pour ce fichier. Elle a peut-être expiré."
          }
        }
      }
    },
    "Apple publishes no usage figure through its API: the gauge needs your plan and the day it resets." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ne publie aucun chiffre de consommation par son API : la jauge a besoin de votre forfait et du jour de sa réinitialisation."
          }
        }
      }
    },
    "Apple’s hourly request limit is reached. Nothing was started; try again later." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite horaire de requêtes d’Apple est atteinte. Rien n’a démarré ; réessayez plus tard."
          }
        }
      }
    },
