{
  "sourceLanguage" : "en",
  "strings" : {
    "  Daily outcome of builds, by workflow. %lld days up to %@." : {
      "comment" : "Caption of the Overview's figure. The placeholders are a number of days and a date such as “Thursday, October 23”. Keep the two spaces at the start.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Issue quotidienne des builds, par workflow. %lld jours jusqu’au %@."
          }
        }
      }
    },
    "“%@”" : {
      "comment" : "A commit's first line, in quotation marks\nIn the bubble of a day of the Overview: the sentence of “In brief” about a failed build, between quotation marks. Use the quotation marks of the language.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ »"
          }
        }
      }
    },
    "“%@” receives every build by itself." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » reçoit d’office tous les builds."
          }
        }
      }
    },
    "(optional)" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(facultatif)"
          }
        }
      }
    },
    "[DD Month YYYY]" : {
      "comment" : "Placeholder of a date in the diagram of App Store Connect's usage page",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[JJ mois AAAA]"
          }
        }
      }
    },
    "**No build** in the last %lld days." : {
      "comment" : "Headline of the Overview when the account has no build in the period the mosaic covers. Put the words for “No build” between the double asterisks, which are not shown. The placeholder is a number of days.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Aucun build** ces %lld derniers jours."
          }
        }
      }
    },
    "%@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "Joins two parts of a line, such as a build's state and its duration. Keep the middle dot.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
