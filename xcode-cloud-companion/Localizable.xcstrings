    },
    "The link in %@ leads to a copy of Cumulus that moved. Repair it to point here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien dans %@ mène à une copie de Cumulus qui a été déplacée. Réparez-le pour qu’il pointe ici."
          }
        }
      }
    },
    "The list of versions couldn’t be read: the version stays as it is." : {
      "localizations" : {
