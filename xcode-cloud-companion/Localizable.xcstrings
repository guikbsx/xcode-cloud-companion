    },
    "The MCP server %@" : {
      "comment" : "Settings, Agents: last thing to add for an agent; the argument says it is optional",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur MCP %@"
          }
        }
      }
    },
    "The agent then calls Cumulus as tools instead of a command." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent appelle alors Cumulus comme des outils, plutôt que par une commande."
          }
        }
      }
    },
    "The app" : {
      "comment" : "Last row of the table of an app's workflows: the figures for the app as a whole",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app"
          }
        }
      }
    },
    "The app reads your Xcode Cloud builds with an API key. It only launches a build or pauses a workflow when you ask it to, and the key stays in your keychain." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app lit vos builds Xcode Cloud avec une clé API. Elle ne lance un build ou ne met un workflow en pause que si vous le demandez, et la clé reste dans votre trousseau."
          }
        }
      }
    },
    "The app starts with your session and stays in the menu bar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app se lance avec votre session et reste dans la barre des menus."
          }
        }
      }
    },
    "The command %@" : {
      "comment" : "Settings, Agents: first thing to install, the argument is the command's name",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La commande %@"
          }
        }
      }
    },
    "The download could not be completed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement n’a pas pu aboutir."
          }
        }
      }
    },
    "The extension could not be saved there." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’extension n’a pas pu être enregistrée à cet endroit."
          }
        }
      }
    },
    "The gauge and the menu bar percentage appear once every build of the cycle is measured." : {
      "localizations" : {
        "fr" : {
