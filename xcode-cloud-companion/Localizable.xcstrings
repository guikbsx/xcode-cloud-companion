    "The latest first, one action at a time. You can stop at any moment." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plus récents d’abord, une action à la fois. Vous pouvez arrêter à tout moment."
          }
        }
