        }
      }
    },
    "The link expired or is invalid (HTTP %lld)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien a expiré ou n’est pas valide (HTTP %lld)."
          }
        }
      }
    },
    "The private key can’t be read. Import the .p8 file downloaded from App Store Connect." : {
      "comment" : "Keep \"Xcode Cloud\", \"App Store Connect\" and \"TestFlight\" untranslated as product names.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé privée est illisible. Importez le fichier .p8 téléchargé depuis App Store Connect."
          }
        }
      }
    },
    "The usage export contains no build." : {
      "localizations" : {
