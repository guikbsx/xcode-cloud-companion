    "An agreement of your team is missing or has expired. The Account Holder must accept it in App Store Connect." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un accord de votre équipe est manquant ou a expiré. Le titulaire du compte doit l’accepter dans App Store Connect."
          }
        }
      }
    },
    "An app is missing? It has no Xcode Cloud workflow yet, or the key has no access to this team." : {
      "comment" : "Keep \"Xcode Cloud\", \"App Store Connect\" and \"TestFlight\" untranslated as product names.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une app manque ? Elle n’a pas encore de workflow Xcode Cloud, ou la clé n’a pas accès à cette équipe."
          }
        }
      }
    },
